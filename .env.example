RELAY_SHARED_SECRET=replace-with-a-long-random-string
# دیباگ موقت — پیش‌فرض روشن: هر درخواست را با مدل/پرامپتش لاگ می‌کند (docker compose logs -f relay)
LOG_PROMPTS=true
# دیباگ موقت — پیش‌فرض خاموش: هدرهای هر درخواست را هم لاگ می‌کند
LOG_HEADERS=false

# اختیاری — docs/PRD-video-edit-omni-kie.md §۳. اگر ست شوند، درخواست‌هایی که با prefix
# /kie یا /kie-upload می‌رسند (به‌جای رفتار پیش‌فرض/OpenRouter) به این upstreamها فوروارد
# می‌شوند. بدون این دو خط، فیچر «ویرایش ویدیو» بک‌اند اصلاً بالا نمی‌آید (KieProviderService
# صریحاً throw می‌کند)، ولی رفتار فعلی OpenRouter کاملاً دست‌نخورده می‌ماند.
# KIE_TARGET_BASE_URL=https://api.kie.ai
# KIE_UPLOAD_TARGET_BASE_URL=https://kieai.redpandaai.co

# اختیاری — docs/PRD-telegram-bot-channel.md. اگر ست شود، درخواست‌هایی که با prefix /telegram
# می‌رسند به این upstream فوروارد می‌شوند (ارسال پیام/دانلود فایل بات تلگرام از پروداکشن ایران).
# TELEGRAM_TARGET_BASE_URL=https://api.telegram.org

# اختیاری — inbound. اگر ست شود، درخواست POST تلگرام به /telegram-webhook روی این relay
# (بدون نیاز به X-Relay-Secret، چون خودِ تلگرام صدا می‌زند) عیناً به این آدرس فوروارد می‌شود.
# این آدرس، آدرس کامل endpoint وبهوک روی بک‌اند ایران است (نه فقط base URL).
# TELEGRAM_WEBHOOK_TARGET_URL=https://api.nivoai.ir/api/v1/v2/telegram/webhook

# اختیاری — docs/PRD-seller-telegram-management-bot.md. بات دوم (مدیریت پنل فروشنده، توکن/
# وبهوک جدا از بات بالا) — outbound همان مسیر /telegram بالا را به اشتراک می‌گذارد (توکن در
# خودِ URL است، ربطی به این relay ندارد)؛ فقط inbound مسیر جدا می‌خواهد چون target فرق دارد.
# SELLER_BOT_WEBHOOK_TARGET_URL=https://api.nivoai.ir/api/v1/v2/seller-bot/webhook
