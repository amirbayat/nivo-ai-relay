RELAY_SHARED_SECRET=replace-with-a-long-random-string
# دیباگ موقت — پیش‌فرض روشن: هر درخواست را با مدل/پرامپتش لاگ می‌کند (docker compose logs -f relay)
LOG_PROMPTS=true
# دیباگ موقت — پیش‌فرض خاموش: هدرهای هر درخواست را هم لاگ می‌کند
LOG_HEADERS=false

# اختیاری — docs/PRD-video-edit-omni-kie.md §۳. اگر ست شوند، درخواست‌هایی که با prefix
# /kie یا /kie-upload می‌رسند (به‌جای رفتار پیش‌فرض/OpenRouter) به این upstreamها فوروارد
# می‌شوند. بدون این دو خط، فیچر «ویرایش ویدیو» بک‌اند اصلاً بالا نمی‌آید (KieProviderService
# صریحاً throw می‌کند)، ولی رفتار فعلی OpenRouter کاملاً دست‌نخورده می‌ماند.
# KIE_TARGET_BASE_URL=https://api.kie.ai
# KIE_UPLOAD_TARGET_BASE_URL=https://kieai.redpandaai.co
